# Host profile for the federation lifecycle. Copy to federation.env and edit.
# The Makefile auto-includes federation.env (gitignored) when present.

# Where the member repos live, relative to this Makefile (or an absolute path
# on the host). Default assumes the infra/ workspace layout (siblings).
INFRA_ROOT=..

# Where 'make clone' fetches the member repos from — an account/namespace
# PREFIX, not a full URL. Each member is cloned from $GIT_REMOTE/<dir>.git.
GIT_REMOTE=https://github.com/nos-tromo
# SSH instead:      GIT_REMOTE=git@github.com:nos-tromo
# Internal mirror:  GIT_REMOTE=https://git.example.internal/mirror/nos-tromo

# Member directory names (override only if your host renames them — the name
# must still match the member's upstream repo name, since 'make clone' derives
# the clone URL from it).
VLLM_DIR=vllm-service
DATA_DIR=data-plane

# Observability plane (Prometheus + Grafana + Loki). Pulled-image member,
# bespoke Makefile. Set empty to run this host without observability.
OBS_DIR=obs-plane

# Edge gateway (Caddy + Authelia) — the single production entry point.
# Pulled-image member, bespoke Makefile. Comes up last, health-gated.
# Set empty to run this host without the gateway.
EDGE_DIR=edge-plane

# First-party (common.mk) apps deployed on THIS host, space-separated dir
# names. Trim to the subset this host actually runs. Only common.mk apps
# belong here — open-webui-service has its own variable below.
APP_DIRS=chorus docint Nextext translator

# The upstream chat UI (pulled image, bespoke Makefile). It is kept out of
# APP_DIRS because it is a different kind of member, NOT because it is
# excluded: it is a full lifecycle member, joining every app-tier loop
# (setup/up/down/ps/logs) and the bundle/load fan-out. Set empty to drop it
# from the federation entirely.
OPENWEBUI_DIR=open-webui-service

# data-plane Qdrant profile: cpu | cuda.
DATA_PROFILE=cpu

# Optional health-probe overrides (see scripts/wait-healthy.sh).
# WAIT_PROBE_IMAGE is the tag the probe container runs; WAIT_PROBE_PIN is the
# digest-pinned reference 'make bundle' pulls and saves for the airgap host.
# Override both together if you swap the probe image — the pin must be a
# digest of the image the tag names.
# WAIT_TIMEOUT=180
# WAIT_PROBE_IMAGE=busybox:1.37
# WAIT_PROBE_PIN=busybox@sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0

# Force 'make bundle' to rebuild every member even when a member's bundle for
# its current release tag already exists (the default skips those, judged by
# the member's .<slug>-version file — see scripts/bundle-exists.sh). Usually
# passed one-shot on the command line instead: make bundle BUNDLE_FORCE=1
# BUNDLE_FORCE=1
